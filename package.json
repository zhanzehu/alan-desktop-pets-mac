{
  "name": "alan-desktop-pets-mac",
  "version": "1.0.0",
  "private": true,
  "description": "邵艾伦、太对了、峰哥 桌面宠物 · macOS 版",
  "main": "src/main/main.js",
  "author": "macOS port",
  "license": "SEE LICENSE IN assets",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "dist": "electron-builder --mac",
    "test": "node test/selftest.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alan.desktop.pets",
    "productName": "Alan Desktop Pets",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
